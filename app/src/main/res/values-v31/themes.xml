<resources>
    <!-- Android 12+: animated launch icon (older versions use the static mark from values/themes.xml) -->
    <style name="Theme.MotionForge.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF0E1218</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.MotionForge</item>
    </style>
</resources>
