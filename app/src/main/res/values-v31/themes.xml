    <style name="Theme.MotionForge.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF2B3BFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.MotionForge</item>
    </style>
</resources>
