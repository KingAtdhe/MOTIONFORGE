<resources>
    <style name="Theme.MotionForge" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0B0B0D</item>
        <item name="android:statusBarColor">#FF0B0B0D</item>
        <item name="android:navigationBarColor">#FF0B0B0D</item>
    </style>

    <!-- Launch screen (androidx core-splashscreen; native on Android 12+, emulated on 8-11):
         the MOTIONFORGE mark on the night background, then the app theme. -->
    <style name="Theme.MotionForge.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF0B0B0D</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MotionForge</item>
    </style>
</resources>
