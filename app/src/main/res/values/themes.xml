<resources>
    <style name="Theme.MotionForge" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FFE8E8E4</item>
        <item name="android:statusBarColor">#FFE8E8E4</item>
        <item name="android:navigationBarColor">#FFE8E8E4</item>
    </style>

    <!-- Launch screen (androidx core-splashscreen; native on Android 12+, emulated on 8-11): the icon's pair on the
         yellow disc, on black (tools/branding_v6), then the app's own launch art (LaunchIntro), then the app. -->
    <style name="Theme.MotionForge.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.MotionForge</item>
    </style>
</resources>
